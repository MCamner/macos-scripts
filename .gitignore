# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/

# Secrets
.env
.env.*
*.key
*.pem

# macOS metadata
.DS_Store
**/.DS_Store

# Editor temp files
*.swp
*.tmp
*~

# Local Playwright CLI captures
.playwright-cli/

# Backups: project-generated snapshots, bundles, and reports are local-only.
# Write scripts mkdir -p their own subdirs at runtime; only the README is tracked.
backups/*
!backups/README.md
terminal/launchers/*.bak.*
terminal/menus/*.bak.*
tools/*.bak.*
